# ==================================================================
# careguard 웹 nginx 설정 (템플릿)
#
# nginx 공식 이미지는 기동 시 /etc/nginx/templates/*.template 을 envsubst 로
# 처리해 /etc/nginx/conf.d/ 로 내보낸다. 그래서 확장자가 .template 이다.
#
# ${NLB_DNS} 와 ${DNS_RESOLVER} 는 컨테이너가 뜰 때 채워진다.
# 내부 NLB 주소는 Terraform 이 apply 할 때 정해지는데 이미지는 GitHub Actions 가
# 빌드하므로 그 값을 알 수 없다. 그래서 이미지에는 "템플릿" 만 넣는다.
#
# ⚠️ envsubst 는 "정의된 환경변수" 이름의 중괄호 형태만 치환한다.
#   따라서 아래 $uri, $host, $remote_addr 같은 nginx 변수는 안전하다.
#   다만 nginx 변수를 중괄호로 감싸 쓰면 치환 대상이 될 수 있으니 쓰지 말 것.
#   달러+중괄호는 아래 두 자리(DNS_RESOLVER, NLB_DNS)에만 등장해야 한다.
# ==================================================================

# ALB 가 TLS 를 종단하고 nginx 로는 HTTP 로 넘어온다. 따라서 여기서
# X-Forwarded-Proto 를 $scheme 으로 세팅하면 항상 "http" 가 되어,
# ALB 가 보낸 "https" 를 덮어써 버린다. -> 원본이 있으면 그대로 보존한다.
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ALB 헬스체크 전용 경로 (infra compute.tf 의 web_tg 가 이걸 본다).
    #
    # "/" 로 두면 index.html 전체를 반환해 불필요하게 무겁고, 아래 SPA 폴백
    # 때문에 dist 가 깨져도 200 이 나올 수 있어 신호가 흐려진다.
    # access_log 를 끄는 이유: 30 초마다 찍히면 로그가 이것만으로 찬다.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # react-router-dom 사용. 이 폴백이 없으면 /members 등에서 새로고침 시 404.
    location / {
        try_files $uri $uri/ /index.html;

        # ------------------------------------------------------------------
        # 보안 응답 헤더 (문서 응답에 적용)
        #
        # CSP 가 이 앱의 XSS 방어 핵심이다. script-src 'self' 는 인라인 스크립트와
        # 인라인 이벤트 핸들러(onerror= 등)를 차단한다 — 회원이 넣은 본문이
        # 화면에 삽입돼도 실행되지 않는다. frame-ancestors 'none' 은 클릭재킹을,
        # base-uri/form-action/object-src 는 각각 base 태그 주입·폼 탈취·플러그인
        # 실행을 막는다.
        #
        # connect-src 는 'self' 에 더해 S3 를 허용한다 — 공지 첨부 업로드가 presign
        # 으로 받은 S3 서명 URL 로 파일을 직접 PUT 하기 때문이다(같은 출처가 아니다).
        # 'self' 만 두면 그 업로드가 CSP 에 막힌다. `https://*.amazonaws.com` 은 넓으니,
        # 운영에서 실제 버킷 호스트가 정해지면 그 도메인으로 좁힐 것.
        #
        # style-src 에 'unsafe-inline' 을 남긴 건 런타임 인라인 스타일 때문이다.
        # 스크립트와 달리 인라인 스타일은 실행 위협이 아니라 남겨 둔다.
        #
        # add_header 는 location 단위로 상속이 끊기므로(하위 블록이 자체
        # add_header 를 두면 서버 레벨 헤더가 사라진다) 문서를 내보내는 이
        # location 에 직접 둔다. 정적 자산(/assets/)에는 nosniff 만 따로 건다.
        # ------------------------------------------------------------------
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.amazonaws.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;
    }

    # 해시가 박힌 빌드 산출물은 내용이 바뀌면 파일명이 바뀌므로 길게 캐시한다.
    # index.html 은 위 폴백이 처리하며 캐시하지 않는다(새 배포가 안 보이면 곤란).
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # 해시 자산도 선언된 Content-Type 을 지키게 한다(스니핑 차단).
        add_header X-Content-Type-Options "nosniff" always;
    }

    # ------------------------------------------------------------------
    # /api 를 내부 NLB 로 프록시
    #
    # 백엔드 컨트롤러가 이미 @RequestMapping("/api/...") 로 매핑되어 있고
    # context-path 도 없으므로 경로를 그대로 넘긴다.
    # (변수를 쓰는 proxy_pass 는 URI 를 재작성하지 않는다)
    #
    # proxy_pass 에 호스트명을 직접 쓰면 nginx 가 기동 시 1 회만 DNS 를 조회하고
    # 결과를 영구 캐시한다. NLB 는 IP 가 바뀔 수 있으므로 변수 + resolver 로
    # 매 요청마다 재조회하게 한다.
    #
    # ⚠️ resolver 주소로 링크로컬(169.254.169.253)을 쓰지 말 것.
    #   호스트에서는 되지만 컨테이너의 브리지 네트워크에서는 라우팅되지 않는다.
    #   VPC DNS 의 일반 주소(VPC 대역 + 2, 예: 192.168.0.2)를 써야 한다.
    #   infra 가 DNS_RESOLVER 로 그 값을 넘긴다.
    # ------------------------------------------------------------------
    location /api/ {
        resolver ${DNS_RESOLVER} valid=10s;
        set $was_upstream "${NLB_DNS}";
        proxy_pass http://$was_upstream:8080;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;

        # WebSocket(채팅) 통과용. 없으면 STOMP/SockJS 핸드셰이크가 실패한다.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        # ALB idle_timeout(300s) 과 맞춘다. 세 구간 중 가장 짧은 값이
        # 실제 타임아웃이 되므로 여기가 더 짧으면 의미가 없다.
        proxy_read_timeout 300s;
    }

    # ------------------------------------------------------------------
    # Swagger UI / OpenAPI 문서
    #
    # 백엔드의 springdoc 은 설정을 따로 주지 않아 기본 경로를 쓴다.
    #   /swagger-ui.html          -> /swagger-ui/index.html 로 리다이렉트
    #   /swagger-ui/*             -> UI 정적 리소스(webjar)
    #   /v3/api-docs, .yaml       -> OpenAPI 문서
    #   /v3/api-docs/swagger-config
    # 전부 /api 밖(루트)이라 위 location /api/ 로는 잡히지 않는다. 이 블록이
    # 없으면 SPA 폴백(try_files ... /index.html)에 걸려 React 페이지가 200 으로
    # 돌아간다 — 404 가 아니라 "엉뚱한 200" 이라 원인을 찾기 더 어렵다.
    #
    # 🔓 이 문서는 인증 없이 공개된다 — 빠뜨린 게 아니라 의도한 설정이다.
    #   백엔드 SecurityConfig 가 anyRequest().permitAll() 이라 Swagger 자체에
    #   인증이 없고, 여기에도 auth_basic 을 걸지 않았다. 즉 API 명세와 스키마,
    #   Try it out 실행까지 인터넷에 그대로 열린다.
    #
    #   다만 이게 없던 구멍을 만드는 것은 아니다. /api/** 는 이미 외부에서
    #   닿고, 그중 /api/users/me, /api/community, /api/boards, /api/chat,
    #   /api/files 는 시큐리티 매처에 안 잡혀 원래부터 무인증이다.
    #   이 블록이 바꾸는 것은 "뚫리느냐" 가 아니라 "지도를 넘기느냐" 다.
    #
    # ▶ 다시 닫는 방법: 이 location 블록을 통째로 지우면 끝이다.
    #   swagger 경로가 다시 SPA 폴백(try_files ... /index.html)으로 떨어져
    #   문서가 닫힌다. 백엔드도 인프라도 건드릴 필요가 없다.
    #
    # ▶ 닫는 대신 인증을 걸고 싶다면 이 블록 안에 두 줄을 넣는다.
    #     auth_basic           "kidhack api docs";
    #     auth_basic_user_file /etc/nginx/.htpasswd;
    #   이때 htpasswd 를 이미지에 굽지 말 것 — Docker Hub 에 해시가 박히고,
    #   private 저장소라도 레지스트리 자격증명이 새면 함께 샌다. WAS 가
    #   firebase.json 을 다루는 방식대로 SSM SecureString 에 넣고 호스트가
    #   부팅 시 파일로 떨궈 마운트하는 것이 이 저장소의 기존 패턴이다.
    #
    # 정규식 location 이라 위 프리픽스 블록들보다 먼저 평가된다. 다만 여기
    # 걸리는 것은 swagger 경로뿐이라 /api/ 프록시와 겹치지 않는다.
    # ------------------------------------------------------------------
    location ~ ^/(swagger-ui|v3/api-docs) {
        resolver ${DNS_RESOLVER} valid=10s;
        set $docs_upstream "${NLB_DNS}";
        proxy_pass http://$docs_upstream:8080;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

        # springdoc 이 /swagger-ui.html -> /swagger-ui/index.html 리다이렉트를
        # 만들 때 이 헤더로 스킴을 정한다. 빼면 https 로 들어온 요청에
        # http 리다이렉트가 나가 브라우저가 혼합 콘텐츠로 막는다.
        proxy_set_header X-Forwarded-Proto $fwd_proto;
    }

    # ------------------------------------------------------------------
    # 채팅 WebSocket
    #
    # 백엔드의 STOMP 엔드포인트는 WebSocketConfig 에서 "/ws-chat" 으로 등록되어
    # 있고 /api 아래가 아니다. 위 location 은 /api/ 로 시작하는 것만 잡으므로
    # 이 블록이 없으면 /ws-chat 이 SPA 폴백(try_files ... /index.html)에 걸려
    # HTML 이 돌아가고, 핸드셰이크가 실패해 채팅이 통째로 죽는다.
    # 웹과 모바일이 같은 경로를 쓴다.
    #
    # proxy_read_timeout 을 넉넉히 잡는 이유: WebSocket 은 유휴 상태로 오래
    # 열려 있는다. 기본 60 초면 대화가 없을 때 nginx 가 먼저 끊는다.
    # ALB idle_timeout 이 300 초이므로 그 밑으로 두면 의미가 없다.
    # ------------------------------------------------------------------
    location /ws-chat {
        resolver ${DNS_RESOLVER} valid=10s;
        set $ws_upstream "${NLB_DNS}";
        proxy_pass http://$ws_upstream:8080;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}